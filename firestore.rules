rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicPets/{petId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.shelterUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.shelterUid == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null
        && resource.data.shelterUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.adopterUid == request.auth.uid
        && request.resource.data.shelterUid is string
        && request.resource.data.type == 'appointment';
      allow update: if request.auth != null
        && resource.data.shelterUid == request.auth.uid;
    }
  }
}
